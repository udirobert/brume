# =================================================================
# Brume — environment template
# =================================================================
# Copy to `.env.local` for the web app, or set the same names in the
# Netlify site env (build) and Netlify function env (server-side).
# Values here are empty on purpose: this file is documentation, and a
# real key in a tracked file is a committed key.
# NEVER commit a filled-in .env file.

# =================================================================
# SIGN-IN — Supabase (email and password only)
# =================================================================
# Project URL and the anon key. The anon key is public by design: it
# identifies the project, it does not authorise anything on its own —
# the row-level policies do. Still keep the real one out of git.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =================================================================
# THE VOICE — AssemblyAI (server-side only, no VITE_ prefix)
# =================================================================
# Two moments ask for it: tapping "say it" on a check-in, and asking
# Brume to speak a line. Both are the function's business, never the
# bundle's — a VITE_-prefixed version of this key would ship the key in
# public JavaScript.
#
# Used by netlify/functions/tts.mjs in production, the /api/tts dev
# middleware in vite.config.ts, and scripts/generate-voice.mjs offline.
ASSEMBLYAI_API_KEY=
# Optional. Unset, the default voice is used; production uses Irwin
# (6e942141-672b-55cd-8f54-1bbad2facdac), auditioned from
# tts.us.assemblyai.com/v1/voices.
ASSEMBLYAI_VOICE_ID=

# =================================================================
# THE COUNTER — netlify/functions/metrics.mjs
# =================================================================
# Daily aggregates live in Netlify Blobs: no credential to configure.
# Set this in the *function* env (never a VITE_ var) and
# GET /api/metrics starts requiring "Authorization: Bearer <token>".
# Unset, the counts stay open.
METRICS_READ_TOKEN=

# =================================================================
# OPTIONAL — what the app reads if you set it
# =================================================================
# Where the site is served from, for share links and the room invite.
VITE_APP_URL=

# =================================================================
# NOT PART OF THIS PRODUCT
# =================================================================
# These variable names appear in old branches, in the legacy service
# clusters under src/lib/{api,ai,offline,errors}, and in the deploy
# notes of previous versions. Nothing in the app should read them, and
# the app has no place to put them:
#
#   VITE_FLOW_* / VITE_LENS_* / VITE_WALLETCONNECT_* / CHAIN_ID /
#   PRIVATE_KEY            — the wallet and chain sign-in was cut on
#                            2026-11-04. Sign-in is an email.
#   VITE_GOOGLE_GEMINI_API_KEY / VITE_OPENAI_API_KEY /
#   VITE_ANTHROPIC_API_KEY — a VITE_-prefixed key is a published key.
#                            Analysis of what someone told Brume is not
#                            something the app does.
#   VITE_ENABLE_CAMERA     — there is no camera path in the app, and
#                            the product says it does not sense you.
#   VITE_ENABLE_TRIAL_SYSTEM / VITE_MAX_FREE_ANALYSES — nothing is
#                            rationed and there is no tier to read.
#
# If a build of this repository needs one of these back, it is a
# decision to write down in AGENTS.md and PrivacyPolicy.tsx first.

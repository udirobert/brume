# Copy to .env.local (gitignored) for local real-LLM prompt checks (scripts/prompt-check.mjs).
# Preferred: Gemini, the model family Anna serves by default (free key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional fallback proxy (Featherless Chat plan forbids automated/benchmark traffic).
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324
# Anna llm.complete default temperature
LLM_TEMPERATURE=0.7

{
  "schema": 3,
  "tags": [
    "breathing",
    "reset",
    "break"
  ],
  "storage": {
    "kv": true,
    "files": false,
    "scopes": {
      "user": "rw"
    }
  },
  "host_capabilities": [
    "llm.complete",
    "llm.sample"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:brume",
      "min_version": "0.2.1",
      "version": "latest"
    }
  ],
  "system_prompt_addendum": "Brume offers one quiet guided breathing break. When the user asks for a break or reset (e.g. '#brume reset'), call brume_reset once and let its guided text stand \u2014 it is rendered verbatim, so do not restate or paraphrase it. When the user signals they finished (e.g. 'done'), call brume_complete. Never start a break unprompted and never claim health or wellness benefits; describe only what happened.",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Brume Reset",
        "default": true,
        "default_size": {
          "w": 420,
          "h": 520
        },
        "min_size": {
          "w": 320,
          "h": 360
        },
        "single_instance": true,
        "summary_template": "Reset breathing break"
      }
    ],
    "host_api": {
      "storage": [
        "get",
        "set"
      ],
      "llm": [
        "complete"
      ],
      "window": [
        "set_title"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "mocks": {
      "llm.complete": {
        "result": {
          "role": "assistant",
          "content": {
            "type": "text",
            "text": "Carry this quiet into whatever comes next."
          },
          "model": "mock-model",
          "stopReason": "endTurn",
          "usage": {
            "inputTokens": 40,
            "outputTokens": 9,
            "totalTokens": 49
          }
        }
      }
    }
  },
  "optional_executas": [
    {
      "tool_id": "skill-u3f06a4c-brume-reset-offer-62gn2cgc"
    }
  ]
}

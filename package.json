{
  "name": "brume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" VITE_APP_ENV=production vite build --emptyOutDir",
    "build:secure": "node scripts/secure-build.cjs",
    "build:dev": "NODE_OPTIONS=\"--max-old-space-size=4096\" VITE_APP_ENV=development vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "debug:prod": "node scripts/debug-production.js",
    "setup": "./scripts/setup-dependencies.sh",
    "security": "./scripts/security-check.sh",
    "security:secrets": "node scripts/check-build-secrets.cjs",
    "deploy": "./scripts/check-deployment-status.sh",
    "deploy:vision": "cd backend/vision-service && ./deploy-hetzner.sh",
    "deploy:firewall": "./scripts/setup-hetzner-firewall.sh",
    "deploy:domain": "./scripts/setup-api-domain.sh",
    "lens:v3-only": "echo 'Lens V3-only implementation active'",
    "verify:blockchain": "node scripts/verify-blockchain-connections.cjs",
    "verify:lens": "node scripts/verify-blockchain-connections.cjs --network=lens",
    "verify:flow": "node scripts/verify-blockchain-connections.cjs --network=flow",
    "verify:api": "node scripts/verify-blockchain-connections.cjs --api-only",
    "lens:dev": "pnpm run dev",
    "security:audit": "node scripts/security-audit.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "pnpm exec cap sync",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:open:android": "pnpm exec cap open android",
    "mobile:build": "pnpm run build && pnpm exec cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@netlify/blobs": "11.1.7",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@revenuecat/purchases-capacitor": "13.7.4",
    "@sentry/react": "11.8.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "14.3.0",
    "onesignal-cordova-plugin": "5.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-animation-delay": "2.0.2",
    "wagmi": "3.7.11",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
